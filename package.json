{
  "name": "testing",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-site Astro monorepo starter for agencies and multi-brand companies",
  "license": "MIT",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "node scripts/build.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "import-photo": "node scripts/import-photo.mjs",
    "migrate-media": "node scripts/migrate-media-to-r2.mjs",
    "lint": "turbo lint",
    "prepare": "git config core.hooksPath .githooks || true",
    "new-site": "./scripts/new-site.sh",
    "setup-infra": "./scripts/setup-infra.sh"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5"
  }
}
