---
/**
 * CpaBlog.astro
 * -------------
 * "Latest from our blog" teasers. Figma node 112:13609.
 * Header row with eyebrow + heading + "View All Articles", then 3 post cards.
 */
export interface BlogPost {
  tag: string;
  date: string;
  title: string;
  href: string;
  imageSrc: string;
  imageAlt: string;
}

export interface Props {
  eyebrow: string;
  title: string;
  posts: BlogPost[];
  viewAll: { text: string; href: string };
  linkText?: string;
}

const { eyebrow, title, posts, viewAll, linkText = 'Learn More' } = Astro.props;
---

<section class="blog" aria-label="Latest articles">
  <div class="blog__inner cpa-container">
    <div class="blog__head">
      <div class="blog__head-text">
        <span class="blog__eyebrow">{eyebrow}</span>
        <h2 class="blog__title">{title}</h2>
      </div>
      <a href={viewAll.href} class="blog__viewall">
        {viewAll.text}
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <ul class="blog__cards">
      {posts.map((post) => (
        <li class="post-card">
          <a href={post.href} class="post-card__media">
            <img src={post.imageSrc} alt={post.imageAlt} loading="lazy" width="470" height="310" />
          </a>
          <div class="post-card__body">
            <div class="post-card__tags">
              <span class="post-card__tag">{post.tag}</span>
              <span class="post-card__date">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="4.5" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 8h14M7 3v3M13 3v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                {post.date}
              </span>
            </div>
            <h3 class="post-card__title">{post.title}</h3>
            <a href={post.href} class="post-card__link">
              {linkText}
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .blog { background: var(--cpa-surface, #f4f4ef); }
  .blog__inner {
    display: flex;
    flex-direction: column;
    gap: 31px;
    padding-block: 80px;
  }

  .blog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .blog__head-text { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .blog__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border: 1px solid var(--cpa-black, #000);
    border-radius: 30px;
    font-size: 16px;
    font-weight: 600;
    line-height: 16px;
    text-transform: uppercase;
    color: var(--cpa-black, #000);
  }
  .blog__title {
    font-size: var(--cpa-fs-h2, 42px);
    font-weight: 600;
    line-height: var(--cpa-lh-h2, 54px);
    color: var(--cpa-black, #000);
    margin: 0;
  }
  .blog__viewall {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 60px;
    padding: 14px 32px;
    border: 1px solid var(--cpa-black, #000);
    border-radius: var(--cpa-radius-btn, 4px);
    color: var(--cpa-black, #000);
    font-size: var(--cpa-fs-large, 18px);
    font-weight: 600;
    line-height: 24px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .blog__viewall:hover { background: var(--cpa-black, #000); color: #fff; }

  .blog__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 23px;
    background: var(--cpa-white, #fff);
    border: 1px solid var(--cpa-border, #d9d9d9);
    border-radius: 12px;
    overflow: hidden;
  }
  .post-card__media { display: block; height: 310px; overflow: hidden; }
  .post-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .post-card__body { display: flex; flex-direction: column; gap: 20px; padding: 0 30px 30px; }
  .post-card__tags { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .post-card__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 130px;
    height: 30px;
    padding: 0 10px;
    background: var(--cpa-red, #bc1a18);
    color: #fff;
    border-radius: 3px;
    font-size: 14px;
    font-weight: 600;
    line-height: 16px;
    text-transform: uppercase;
  }
  .post-card__date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--cpa-black, #000);
    font-size: 14px;
    font-weight: 600;
    line-height: 16px;
    text-transform: uppercase;
  }
  .post-card__title {
    font-size: var(--cpa-fs-subtitle, 20px);
    font-weight: 600;
    line-height: var(--cpa-lh-subtitle, 28px);
    color: var(--cpa-black, #000);
    margin: 0;
  }
  .post-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--cpa-red, #bc1a18);
    font-size: var(--cpa-fs-large, 18px);
    font-weight: 600;
    line-height: 24px;
    margin-top: auto;
  }

  @media (max-width: 1024px) {
    .blog__inner { padding-block: 60px; }
    .blog__cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .blog__inner { padding-block: 48px; }
    .blog__head { flex-direction: column; align-items: flex-start; }
    .blog__cards { grid-template-columns: 1fr; }
  }
</style>
