---
/**
 * CpaFeatureStrip.astro
 * ---------------------
 * Four-up icon + label strip below the hero. Figma node 241:22300.
 * Red 70px rounded-16 icon tiles with white glyphs, SemiBold 16/24 labels.
 */
export type FeatureIcon = 'calendar-check' | 'adjust' | 'deadline' | 'pricing';

export interface FeatureItem {
  icon: FeatureIcon;
  text: string;
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<section class="feature-strip" aria-label="Highlights">
  <div class="feature-strip__inner cpa-container">
    {items.map((item) => (
      <div class="feature-strip__item">
        <span class="feature-strip__icon" aria-hidden="true">
          {item.icon === 'calendar-check' && (
            <svg viewBox="0 0 40 40" width="40" height="40" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="9" width="28" height="25" rx="3"/><path d="M6 16h28M13 5v6M27 5v6M15 25l3.5 3.5L26 21"/></svg>
          )}
          {item.icon === 'adjust' && (
            <svg viewBox="0 0 40 40" width="40" height="40" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13h24M8 27h24"/><circle cx="16" cy="13" r="4" fill="#bc1a18"/><circle cx="26" cy="27" r="4" fill="#bc1a18"/></svg>
          )}
          {item.icon === 'deadline' && (
            <svg viewBox="0 0 40 40" width="40" height="40" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="9" width="28" height="25" rx="3"/><path d="M6 16h28M13 5v6M27 5v6"/><circle cx="20" cy="25" r="5"/><path d="M20 22.5V25l1.6 1.2"/></svg>
          )}
          {item.icon === 'pricing' && (
            <svg viewBox="0 0 40 40" width="40" height="40" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7v26M25.5 12.5c-1.2-1.6-3.2-2.5-5.5-2.5-3.3 0-6 1.8-6 4.4 0 6.1 12 3.2 12 9.3 0 2.6-2.7 4.4-6 4.4-2.6 0-4.8-1.1-5.8-2.9"/></svg>
          )}
        </span>
        <p class="feature-strip__text">{item.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .feature-strip {
    background: var(--cpa-bg-muted, #f9f9f9);
  }
  .feature-strip__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 29px;
  }
  .feature-strip__item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px;
  }
  .feature-strip__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    background: var(--cpa-red, #bc1a18);
    border-radius: var(--cpa-radius, 16px);
  }
  .feature-strip__icon svg { width: 40px; height: 40px; }
  .feature-strip__text {
    width: 220px;
    max-width: 220px;
    font-size: var(--cpa-fs-body, 16px);
    font-weight: 600;
    line-height: var(--cpa-lh-body, 24px);
    color: var(--cpa-black, #000);
  }

  @media (max-width: 1024px) {
    .feature-strip__inner { flex-wrap: wrap; gap: 24px; }
    .feature-strip__item { flex: 1 1 40%; justify-content: flex-start; }
  }
  @media (max-width: 767px) {
    .feature-strip__item { flex: 1 1 100%; }
    .feature-strip__text { width: auto; }
  }
</style>
