---
/**
 * CpaFooter.astro
 * ---------------
 * Site footer for the CPA template. Figma node 112:13611.
 * Brand + socials block, link columns, contact column, and a copyright line.
 */
export interface FooterLink {
  label: string;
  href: string;
}
export interface FooterLinkColumn {
  title: string;
  links: FooterLink[];
  /** Dim the links slightly (Figma "Company" column, opacity 80%). */
  muted?: boolean;
}
export interface FooterSocial {
  platform: 'facebook' | 'twitter' | 'linkedin' | 'instagram';
  href: string;
}
export interface FooterContact {
  title: string;
  intro: string;
  phone?: string;
  phoneHref?: string;
  email?: string;
  emailHref?: string;
  addressLines?: string[];
}

export interface Props {
  logoSrc?: string;
  logoAlt?: string;
  tagline: string;
  followLabel?: string;
  socials: FooterSocial[];
  linkColumns: FooterLinkColumn[];
  contact: FooterContact;
  copyright: string;
  legalLinks: FooterLink[];
}

const {
  logoSrc,
  logoAlt = 'Company logo',
  tagline,
  followLabel = 'Follow us',
  socials,
  linkColumns,
  contact,
  copyright,
  legalLinks,
} = Astro.props;

const socialLabels: Record<FooterSocial['platform'], string> = {
  facebook: 'Facebook',
  twitter: 'X (Twitter)',
  linkedin: 'LinkedIn',
  instagram: 'Instagram',
};
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner cpa-container">
    <div class="footer__top">
      <!-- Brand -->
      <div class="footer__brand">
        <img src={logoSrc} alt={logoAlt} class="footer__logo" width="366" height="83" />
        <p class="footer__tagline">{tagline}</p>
        <div class="footer__social">
          <p class="footer__social-title">{followLabel}</p>
          <ul class="footer__social-list">
            {socials.map((s) => (
              <li>
                <a href={s.href} class="footer__social-link" aria-label={socialLabels[s.platform]}>
                  {s.platform === 'facebook' && (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.9c0-.7.5-.9.8-.9H16V3.2L14 3.2c-2.4 0-3 1.8-3 2.9v2.4H9v2.9h2V21h3v-9.6h2.2l.3-2.9H14z"/></svg>
                  )}
                  {s.platform === 'twitter' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.2 3h3.3l-7.2 8.2L23 21h-6.6l-5.2-6.8L5.3 21H2l7.7-8.8L1.8 3h6.8l4.7 6.2L18.2 3zm-1.2 16h1.8L7.1 4.9H5.2L17 19z"/></svg>
                  )}
                  {s.platform === 'linkedin' && (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M6.9 8.8V19H3.6V8.8h3.3zM5.2 3.5c1.1 0 1.9.8 1.9 1.8s-.8 1.8-1.9 1.8S3.3 6.3 3.3 5.3s.8-1.8 1.9-1.8zM20.4 19h-3.3v-5.4c0-1.4-.5-2.3-1.7-2.3-.9 0-1.5.6-1.7 1.3-.1.2-.1.5-.1.8V19H10s.05-9.3 0-10.2h3.3v1.4c.4-.7 1.2-1.7 3-1.7 2.2 0 3.9 1.4 3.9 4.5V19z"/></svg>
                  )}
                  {s.platform === 'instagram' && (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Columns -->
      <div class="footer__columns">
        {linkColumns.map((col) => (
          <nav class="footer__col" aria-label={col.title}>
            <h2 class="footer__col-title">{col.title}</h2>
            <span class="footer__rule" aria-hidden="true"></span>
            <ul class:list={['footer__col-list', { 'footer__col-list--muted': col.muted }]}>
              {col.links.map((l) => (
                <li><a href={l.href} class="footer__col-link">{l.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}

        <div class="footer__col footer__col--contact">
          <h2 class="footer__col-title">{contact.title}</h2>
          <span class="footer__rule" aria-hidden="true"></span>
          <div class="footer__contact">
            <p class="footer__contact-intro">{contact.intro}</p>
            {contact.phone && (
              <a href={contact.phoneHref} class="footer__contact-row">
                <svg class="footer__contact-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 3h3l1.5 4-2 1.5a11 11 0 0 0 5 5L17 16.5V19s-9 .5-13-9.5V6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="footer__contact-strong">{contact.phone}</span>
              </a>
            )}
            {contact.email && (
              <a href={contact.emailHref} class="footer__contact-row">
                <svg class="footer__contact-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4" width="15" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 5.5 10 11l7-5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="footer__contact-strong">{contact.email}</span>
              </a>
            )}
            {contact.addressLines && contact.addressLines.length > 0 && (
              <p class="footer__contact-row footer__contact-row--address">
                <svg class="footer__contact-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 18s6-5.3 6-10a6 6 0 1 0-12 0c0 4.7 6 10 6 10z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="10" cy="8" r="2.2" stroke="currentColor" stroke-width="1.5"/></svg>
                <span class="footer__contact-strong">
                  {contact.addressLines.map((line, i) => (
                    <>{i > 0 && <br />}{line}</>
                  ))}
                </span>
              </p>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">{copyright}</p>
      <ul class="footer__legal">
        {legalLinks.map((l, i) => (
          <li class="footer__legal-item">
            {i > 0 && <span class="footer__legal-sep" aria-hidden="true"></span>}
            <a href={l.href} class="footer__legal-link">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--cpa-white, #fff);
  }
  .footer__inner {
    padding-block: 60px;
  }

  .footer__top {
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }

  /* ===== Brand ===== */
  .footer__brand {
    flex: 0 1 580px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .footer__logo {
    height: 68px;
    width: auto;
    object-fit: contain;
  }
  .footer__tagline {
    font-family: var(--cpa-font-large, 'Poppins', sans-serif);
    font-size: var(--cpa-fs-large, 18px);
    font-weight: 400;
    line-height: var(--cpa-lh-large, 28px);
    color: var(--cpa-black, #000);
    max-width: 420px;
  }
  .footer__social { display: flex; flex-direction: column; gap: 12px; }
  .footer__social-title {
    font-family: var(--cpa-font-large, 'Poppins', sans-serif);
    font-size: var(--cpa-fs-large, 18px);
    font-weight: 600;
    line-height: var(--cpa-lh-large, 28px);
    color: var(--cpa-black, #000);
  }
  .footer__social-list {
    display: flex;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: var(--cpa-black, #000);
    color: var(--cpa-white, #fff);
    border-radius: 3px;
    transition: background-color 0.15s ease;
  }
  .footer__social-link:hover { background: var(--cpa-red, #bc1a18); }

  /* ===== Columns ===== */
  .footer__columns {
    flex: 1 1 auto;
    display: flex;
    gap: 40px;
    justify-content: space-between;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
  }
  .footer__col--contact { max-width: 367px; }
  .footer__col-title {
    font-size: var(--cpa-fs-subtitle, 20px);
    font-weight: 600;
    line-height: var(--cpa-lh-subtitle, 28px);
    color: var(--cpa-black, #000);
    margin-bottom: 20px;
  }
  .footer__rule {
    display: block;
    width: 50px;
    height: 3px;
    background: var(--cpa-red, #bc1a18);
    margin-bottom: 20px;
  }
  .footer__col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .footer__col-list--muted { opacity: 0.8; }
  .footer__col-link {
    font-size: var(--cpa-fs-body, 16px);
    font-weight: 500;
    line-height: var(--cpa-lh-body, 24px);
    color: var(--cpa-muted, #606060);
    transition: color 0.15s ease;
  }
  .footer__col-link:hover { color: var(--cpa-red, #bc1a18); }

  /* ===== Contact ===== */
  .footer__contact { display: flex; flex-direction: column; gap: 22px; opacity: 0.9; }
  .footer__contact-intro {
    font-size: var(--cpa-fs-body, 16px);
    font-weight: 400;
    line-height: var(--cpa-lh-body, 24px);
    color: var(--cpa-muted, #606060);
    margin-bottom: 0;
  }
  .footer__contact-row {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: var(--cpa-black, #000);
  }
  .footer__contact-icon { width: 20px; height: 20px; flex-shrink: 0; margin-top: 2px; color: var(--cpa-black, #000); }
  .footer__contact-strong {
    font-size: var(--cpa-fs-body, 16px);
    font-weight: 600;
    line-height: var(--cpa-lh-body, 24px);
  }
  .footer__contact-row--address { align-items: flex-start; }

  /* ===== Bottom ===== */
  .footer__bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--cpa-border, #d9d9d9);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .footer__copyright {
    font-size: var(--cpa-fs-small, 14px);
    font-weight: 500;
    line-height: var(--cpa-lh-small, 20px);
    color: var(--cpa-muted, #606060);
  }
  .footer__legal {
    display: flex;
    align-items: center;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__legal-item { display: flex; align-items: center; gap: 16px; }
  .footer__legal-sep { width: 1px; height: 18px; background: var(--cpa-border, #d9d9d9); }
  .footer__legal-link {
    font-size: var(--cpa-fs-small, 14px);
    font-weight: 500;
    line-height: var(--cpa-lh-small, 20px);
    color: var(--cpa-muted, #606060);
    transition: color 0.15s ease;
  }
  .footer__legal-link:hover { color: var(--cpa-red, #bc1a18); }

  /* ===== Tablet ===== */
  @media (max-width: 1024px) {
    .footer__top { flex-direction: column; gap: 48px; }
    .footer__brand { flex-basis: auto; }
    .footer__columns { flex-wrap: wrap; gap: 40px; justify-content: flex-start; }
    .footer__col { flex: 1 1 200px; }
    .footer__col--contact { flex-basis: 100%; max-width: none; }
  }

  /* ===== Mobile ===== */
  @media (max-width: 767px) {
    .footer__inner { padding-block: 44px; }
    .footer__columns { flex-direction: column; gap: 36px; }
    .footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
