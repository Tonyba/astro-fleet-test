---
/**
 * CpaHero.astro
 * -------------
 * Homepage hero. Figma node 112:13602.
 * Left: eyebrow pill · H1 · lead · buttons · Google/Trustpilot social proof.
 * Right: cut-out photo with CPA badge, floating Google-review card, name card.
 */
import CpaButton from './CpaButton.astro';

export interface HeroButton {
  text: string;
  href: string;
  variant?: 'primary' | 'outline';
}

export interface Props {
  eyebrow: string;
  title: string;
  description: string;
  buttons: HeroButton[];
  photoSrc: string;
  photoAlt: string;
  badgeSrc: string;
  badgeAlt: string;
  reviewCardSrc: string;
  reviewCardAlt: string;
  googleG: string;
  trustpilotStars: string;
  trustpilotStar: string;
  googleRating?: string;
  googleLabel?: string;
  trustpilotLabel?: string;
  nameCard: { name: string; lines: string[] };
}

const {
  eyebrow,
  title,
  description,
  buttons,
  photoSrc,
  photoAlt,
  badgeSrc,
  badgeAlt,
  reviewCardSrc,
  reviewCardAlt,
  googleG,
  trustpilotStars,
  trustpilotStar,
  googleRating = '4.9',
  googleLabel = 'Google Rating',
  trustpilotLabel = 'Excellent',
  nameCard,
} = Astro.props;
---

<section class="hero" aria-label="Introduction">
  <div class="hero__inner cpa-container">
    <div class="hero__text">
      <span class="hero__eyebrow">{eyebrow}</span>
      <h1 class="hero__title">{title}</h1>
      <p class="hero__lead">{description}</p>
      <div class="hero__buttons">
        {buttons.map((b) => (
          <CpaButton text={b.text} href={b.href} variant={b.variant ?? 'primary'} />
        ))}
      </div>
      <div class="hero__proof">
        <div class="hero__proof-item">
          <img src={googleG} alt="" class="hero__proof-google" width="30" height="30" />
          <span class="hero__proof-score">{googleRating}</span>
          <span class="hero__stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 20 20" width="15" height="15" fill="#f5b301"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 15l-5.2 2.6 1-5.8L1.5 7.7l5.9-.9z"/></svg>
            ))}
          </span>
          <span class="hero__proof-label">{googleLabel}</span>
        </div>
        <div class="hero__proof-item">
          <span class="hero__proof-excellent">{trustpilotLabel}</span>
          <img src={trustpilotStars} alt="" class="hero__proof-tpstars" width="107" height="20" />
          <img src={trustpilotStar} alt="" class="hero__proof-tpstar" width="20" height="19" />
          <span class="hero__proof-tplabel">Trustpilot</span>
        </div>
      </div>
    </div>

    <div class="hero__media">
      <img src={photoSrc} alt={photoAlt} class="hero__photo" width="676" height="718" />
      <img src={badgeSrc} alt={badgeAlt} class="hero__badge" width="158" height="169" />
      <img src={reviewCardSrc} alt={reviewCardAlt} class="hero__review" width="237" height="117" />
      <figure class="hero__name">
        <figcaption class="hero__name-title">{nameCard.name}</figcaption>
        <span class="hero__name-rule" aria-hidden="true"></span>
        <p class="hero__name-sub">
          {nameCard.lines.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </p>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--cpa-surface, #f4f4ef);
    overflow: hidden;
  }
  .hero__inner {
    display: flex;
    align-items: center;
    gap: 50px;
    min-height: 717px;
  }

  /* ===== Text ===== */
  .hero__text {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
    padding-block: 40px;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border: 1px solid var(--cpa-black, #000);
    border-radius: 30px;
    font-size: 16px;
    font-weight: 600;
    line-height: 16px;
    text-transform: uppercase;
    color: var(--cpa-black, #000);
  }
  .hero__title {
    font-size: var(--cpa-fs-h1, 52px);
    font-weight: 600;
    line-height: var(--cpa-lh-h1, 60px);
    color: var(--cpa-black, #000);
    margin: 0;
  }
  .hero__lead {
    font-family: var(--cpa-font-large, 'Poppins', sans-serif);
    font-size: var(--cpa-fs-large, 18px);
    font-weight: 400;
    line-height: var(--cpa-lh-large, 28px);
    color: var(--cpa-black, #000);
    margin: 0;
  }
  .hero__buttons { display: flex; flex-wrap: wrap; gap: 12px; }

  /* ===== Social proof ===== */
  .hero__proof {
    display: flex;
    align-items: center;
    gap: 43px;
    flex-wrap: wrap;
  }
  .hero__proof-item { display: flex; align-items: center; gap: 8px; }
  .hero__proof-google { width: 30px; height: 30px; }
  .hero__proof-score { font-size: 16px; font-weight: 700; }
  .hero__stars { display: inline-flex; gap: 2px; }
  .hero__proof-label { font-size: 16px; font-weight: 600; }
  .hero__proof-excellent { font-size: 16px; font-weight: 700; }
  .hero__proof-tpstars { height: 20px; width: auto; }
  .hero__proof-tpstar { width: 20px; height: 19px; }
  .hero__proof-tplabel { font-size: 17px; font-weight: 700; }

  /* ===== Media ===== */
  .hero__media {
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    align-self: stretch;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .hero__photo {
    width: 100%;
    max-width: 676px;
    height: 100%;
    max-height: 718px;
    object-fit: contain;
    object-position: bottom center;
  }
  .hero__badge {
    position: absolute;
    left: 4.7%;
    top: 20%;
    width: 23%;
    max-width: 158px;
    height: auto;
  }
  .hero__review {
    position: absolute;
    left: 63%;
    top: 27%;
    width: 35%;
    max-width: 237px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.12));
  }
  .hero__name {
    position: absolute;
    left: 14%;
    bottom: 8%;
    width: 25%;
    max-width: 169px;
    min-width: 130px;
    margin: 0;
    padding: 7px 6px 10px;
    background: #fff;
    border-radius: 5px;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
    text-align: center;
  }
  .hero__name-title {
    font-family: var(--cpa-font-script, 'Mr De Haviland', cursive);
    font-size: 40px;
    line-height: 1.1;
    color: var(--cpa-black, #000);
  }
  .hero__name-rule {
    display: block;
    height: 1px;
    background: var(--cpa-black, #000);
    margin: 4px 6px 6px;
  }
  .hero__name-sub {
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--cpa-black, #000);
  }

  /* ===== Tablet ===== */
  @media (max-width: 1024px) {
    .hero__inner { gap: 32px; min-height: 0; }
    .hero__title { font-size: 42px; line-height: 50px; }
    .hero__text { padding-block: 48px; }
  }

  /* ===== Mobile ===== */
  @media (max-width: 767px) {
    .hero__inner { flex-direction: column; align-items: stretch; }
    .hero__text { padding-block: 40px 8px; gap: 24px; }
    .hero__title { font-size: 34px; line-height: 42px; }
    .hero__buttons { width: 100%; }
    .hero__buttons :global(.cpa-btn) { flex: 1 1 auto; }
    .hero__media {
      align-self: center;
      width: 100%;
      max-width: 420px;
      padding-bottom: 24px;
    }
    .hero__proof { gap: 24px; }
  }
</style>
