---
/**
 * CpaTestimonials.astro
 * ---------------------
 * "What our clients say" reviews. Figma node 112:13606.
 * Scrollable row of review cards with prev/next arrows, dots, Google rating,
 * and a Book Consultation CTA.
 */
import CpaButton from './CpaButton.astro';

export interface Testimonial {
  quote: string;
  name: string;
  role: string;
  avatarSrc: string;
}

export interface Props {
  title: string;
  testimonials: Testimonial[];
  googleG: string;
  googleRating?: string;
  googleLabel?: string;
  reviewsLabel?: string;
  ctaText: string;
  ctaHref: string;
}

const {
  title,
  testimonials,
  googleG,
  googleRating = '4.9',
  googleLabel = 'Google Rating',
  reviewsLabel = 'Read our 40 reviews',
  ctaText,
  ctaHref,
} = Astro.props;
---

<section class="reviews" id="reviews" aria-label="Client testimonials">
  <div class="reviews__inner cpa-container">
    <h2 class="reviews__title">{title}</h2>

    <div class="reviews__carousel">
      <button type="button" class="reviews__arrow reviews__arrow--prev" aria-label="Previous testimonials">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l-6 6 6 6"/></svg>
      </button>

      <ul class="reviews__track">
        {testimonials.map((t) => (
          <li class="review-card">
            <div class="review-card__stars" aria-label="Rated 5 out of 5">
              <span class="review-card__stars-row" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 20 20" width="17" height="17" fill="#f5b301"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 15l-5.2 2.6 1-5.8L1.5 7.7l5.9-.9z"/></svg>
                ))}
              </span>
              <svg class="review-card__verified" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="#2a78fc"/><path d="M6 10l2.6 2.6L14 7.2" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p class="review-card__quote">{t.quote}</p>
            <div class="review-card__user">
              <img src={t.avatarSrc} alt={`${t.name} portrait`} class="review-card__avatar" width="43" height="43" loading="lazy" />
              <div class="review-card__meta">
                <p class="review-card__name">{t.name}</p>
                <p class="review-card__role">{t.role}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <button type="button" class="reviews__arrow reviews__arrow--next" aria-label="Next testimonials">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4l6 6-6 6"/></svg>
      </button>
    </div>

    <div class="reviews__dots" aria-hidden="true">
      {testimonials.map((_, i) => (
        <span class:list={['reviews__dot', { 'is-active': i === 0 }]}></span>
      ))}
    </div>

    <div class="reviews__proof">
      <img src={googleG} alt="" width="30" height="30" />
      <span class="reviews__score">{googleRating}</span>
      <span class="reviews__stars" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 20 20" width="15" height="15" fill="#f5b301"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 15l-5.2 2.6 1-5.8L1.5 7.7l5.9-.9z"/></svg>
        ))}
      </span>
      <span class="reviews__proof-label">{googleLabel}</span>
      <span class="reviews__proof-sep">{reviewsLabel}</span>
    </div>

    <CpaButton text={ctaText} href={ctaHref} variant="primary" />
  </div>
</section>

<style>
  .reviews { background: var(--cpa-white, #fff); }
  .reviews__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-block: 72px;
  }
  .reviews__title {
    font-size: var(--cpa-fs-h2, 42px);
    font-weight: 600;
    line-height: var(--cpa-lh-h2, 54px);
    color: var(--cpa-black, #000);
    text-align: center;
    margin-bottom: 10px;
  }

  .reviews__carousel {
    display: flex;
    align-items: center;
    gap: 27px;
    width: 100%;
  }
  .reviews__arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: var(--cpa-red, #bc1a18);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .reviews__arrow:hover { background: #a01614; }

  .reviews__track {
    list-style: none;
    margin: 0;
    padding: 4px;
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 60px) / 4);
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .reviews__track::-webkit-scrollbar { display: none; }

  .review-card {
    scroll-snap-align: start;
    background: var(--cpa-surface, #f4f4ef);
    min-height: 401px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    padding: 40px 32px;
  }
  .review-card__stars { display: flex; align-items: center; gap: 6px; }
  .review-card__stars-row { display: inline-flex; gap: 2px; }
  .review-card__verified { width: 20px; height: 20px; }
  .review-card__quote {
    font-size: var(--cpa-fs-body, 16px);
    font-weight: 500;
    line-height: var(--cpa-lh-body, 24px);
    color: var(--cpa-black, #000);
    margin: 0;
  }
  .review-card__user { display: flex; align-items: center; gap: 10px; }
  .review-card__avatar { width: 43px; height: 43px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .review-card__meta { display: flex; flex-direction: column; gap: 4px; }
  .review-card__name { font-size: 16px; font-weight: 600; line-height: 24px; color: var(--cpa-black, #000); }
  .review-card__role { font-size: 14px; font-weight: 500; line-height: 20px; color: var(--cpa-black, #000); }

  .reviews__dots { display: flex; gap: 10px; }
  .reviews__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cpa-border, #d9d9d9); }
  .reviews__dot.is-active { background: var(--cpa-red, #bc1a18); }

  .reviews__proof { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .reviews__proof img { width: 30px; height: 30px; }
  .reviews__score { font-size: 16px; font-weight: 700; }
  .reviews__stars { display: inline-flex; gap: 2px; }
  .reviews__proof-label { font-size: 16px; font-weight: 600; }
  .reviews__proof-sep { font-size: 14px; font-weight: 500; color: var(--cpa-black, #000); }

  @media (max-width: 1024px) {
    .reviews__inner { padding-block: 56px; }
    .reviews__track { grid-auto-columns: calc((100% - 20px) / 2); }
  }
  @media (max-width: 767px) {
    .reviews__carousel { gap: 12px; }
    .reviews__arrow { display: none; }
    .reviews__track { grid-auto-columns: 85%; }
  }
</style>

<script>
  function initReviews() {
    document.querySelectorAll('.reviews__carousel').forEach((carousel) => {
      const track = carousel.querySelector('.reviews__track');
      const prev = carousel.querySelector('.reviews__arrow--prev');
      const next = carousel.querySelector('.reviews__arrow--next');
      if (!track || !prev || !next) return;
      const step = () => track.clientWidth / 2 || 320;
      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    });
  }
  initReviews();
  document.addEventListener('astro:after-swap', initReviews);
</script>
