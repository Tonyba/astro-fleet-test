---
/**
 * TreePicture.astro
 * -----------------
 * The single entry point for every photograph on the site.
 *
 * Wraps Astro's `<Picture />` so each slot gets the right responsive ladder:
 * AVIF + WebP `<source>`s over a JPEG fallback (PNG when the source keeps real
 * transparency), quality 90, intrinsic `width`/`height` always emitted so the
 * box is reserved before the bytes land.
 *
 * `src` accepts an imported asset, an `r2:<key>` value written by the CMS
 * uploader, or the repo path a hand-placed photo uses
 * (`/src/assets/photos/hero-bg.jpg`) — see utils/images.ts. All three come out
 * of the same ladder: an R2 image is fetched from the bucket during the build
 * and encoded by sharp exactly like a local one, so nothing is resized at
 * request time and no image-transformation service is involved.
 *
 * Anything that cannot be re-encoded (an SVG or GIF, in the bucket or in
 * public/) degrades to a plain `<img>` rather than failing the build.
 *
 * Pass `mobileSrc` when the design art-directs a different crop below the
 * breakpoint (the hero does). `<Picture />` cannot express art direction, so
 * that path builds the same AVIF/WebP/fallback ladder through `getImage()` and
 * emits the `<picture>` by hand — one component, identical output contract.
 */
import type { ImageMetadata } from 'astro';
import { getImage, Picture } from 'astro:assets';
import { resolveImage, remoteSource, peek, ladderFor, usesLadder } from '../utils/images';
import { extensionOf } from '../media/media-url';

/** Where the image sits in the layout — decides the srcset ladder. */
export type PictureVariant = 'hero' | 'card' | 'inline' | 'fixed';

export interface Props {
  src: string | ImageMetadata;
  alt: string;
  /** Layout box in CSS pixels. Both are required — they become the intrinsic attrs. */
  width: number;
  height: number;
  variant?: PictureVariant;
  class?: string;
  pictureClass?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  sizes?: string;
  /** Set on the <img> when the image is purely decorative. */
  ariaHidden?: boolean;
  /** Art direction: alternate source used below `mobileMedia`. */
  mobileSrc?: string | ImageMetadata;
  mobileWidth?: number;
  mobileHeight?: number;
  mobileMedia?: string;
  mobileVariant?: PictureVariant;
}

/** Widths rendered per slot. Astro clamps these to the source width — never upscales. */
const VARIANT_WIDTHS: Record<Exclude<PictureVariant, 'fixed'>, number[]> = {
  hero: [640, 1024, 1440, 1920],
  card: [400, 800],
  inline: [600, 1200],
};

const FORMATS = ['avif', 'webp'] as const;
const QUALITY = 90;

const {
  src,
  alt,
  width,
  height,
  variant = 'inline',
  class: className,
  pictureClass,
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  sizes,
  ariaHidden,
  mobileSrc,
  mobileWidth,
  mobileHeight,
  mobileMedia = '(max-width: 1024px)',
  mobileVariant,
  ...rest
} = Astro.props as Props & Record<string, unknown>;

// This component's root is a conditional, so Astro cannot hoist the caller's
// scoped-style id onto it automatically. Forward it by hand, otherwise scoped
// selectors in the parent stop matching the rendered <picture>/<img>.
const cidAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-astro-cid'))
);

/** `fixed` slots (badges, step icons) only ever need 1x/2x of their box. */
const widthsFor = (v: PictureVariant, w: number) =>
  v === 'fixed' ? [w, w * 2] : VARIANT_WIDTHS[v];

const sizesFor = (v: PictureVariant, w: number) =>
  ({
    hero: '100vw',
    card: `(max-width: 767px) 100vw, ${w}px`,
    inline: `(max-width: 1024px) 100vw, ${w}px`,
    fixed: `${w}px`,
  })[v];

// PNG sources are only kept when the alpha channel is load-bearing, so they must
// not fall back to JPEG. Everything else gets the JPEG fallback.
const fallbackFor = (image: ImageMetadata) => (peek(image).format === 'png' ? 'png' : 'jpeg');

const image = resolveImage(src);
const mobileImage = mobileSrc ? resolveImage(mobileSrc) : undefined;
const widths = widthsFor(variant, width);
const resolvedSizes = sizes ?? sizesFor(variant, width);

const mWidth = mobileWidth ?? width;
const mHeight = mobileHeight ?? height;
const mVariant = mobileVariant ?? variant;
const mSizes = sizesFor(mVariant, mWidth);

// ---- R2 sources -----------------------------------------------------------
// A CMS upload lives in the bucket, not the repo, so there is no ImageMetadata
// to import — there is a URL. Astro treats that the same way once the bucket is
// listed in `image.remotePatterns`: it downloads the original during the build,
// measures it (`inferSize`), and encodes the same ladder sharp would produce
// for a local file. The output is indistinguishable — local AVIF/WebP files in
// dist/_astro, nothing resized at request time.
const remoteUrl = image ? undefined : remoteSource(src);
const mobileRemoteUrl = mobileSrc && !mobileImage ? remoteSource(mobileSrc) : undefined;

/** Vector and animated formats: sharp has nothing to add, so they pass through. */
const RAW_FORMATS = new Set(['svg', 'gif', 'ico']);

/**
 * `usesLadder()` is the guard that keeps this off the request path. On a
 * prerendered site, rendering happens during the build and encoding here is
 * free; on an on-demand site the ladder was pre-computed by a prerendered
 * endpoint, and anything missing from it must be served as-is rather than
 * handed to a workerd runtime with no sharp in it.
 */
const canBuildRemote = (url: string) => !usesLadder() && !RAW_FORMATS.has(extensionOf(url));

/**
 * Source dimensions for a remote image, measured once per build.
 *
 * Astro will not upscale, but without knowing the source width it still ENCODES
 * every width asked for — a 1200px original asked for 1440w and 1920w produces
 * two more files identical to the 1200w one. Measuring first lets the ladder be
 * clamped the way it is for a local import, so each distinct size is encoded
 * exactly once.
 *
 * Imported dynamically so the probe never lands in a worker bundle: the branch
 * that calls it cannot run at request time (see `canBuildRemote`).
 */
const remoteSizes = new Map<string, { width: number; height: number } | null>();
const probeRemote = async (url: string) => {
  if (!remoteSizes.has(url)) {
    remoteSizes.set(
      url,
      await import('astro/assets/utils')
        .then((utils) => utils.inferRemoteSize(url))
        .catch(() => null)
    );
  }
  return remoteSizes.get(url) ?? null;
};

const remoteLadder = async (url: string, w: number, h: number, v: PictureVariant) => {
  const fallbackFormat = extensionOf(url) === 'png' ? 'png' : 'jpeg';
  const size = await probeRemote(url);

  // Widths above the source all collapse onto it — so drop them, but keep the
  // source width itself in their place. Dropping them outright would cap the
  // ladder at the next size down and hand a large screen a smaller image than
  // the bucket actually holds.
  const requested = widthsFor(v, w);
  const ladderWidths = size
    ? [
        ...requested.filter((rung) => rung < size.width),
        ...(requested.some((rung) => rung >= size.width) ? [size.width] : []),
      ]
    : requested;

  const [avif, webp, fallback] = await Promise.all(
    (['avif', 'webp', fallbackFormat] as const).map((format) =>
      getImage({
        src: url,
        // Known dimensions beat a second probe inside Astro; `inferSize` is the
        // fallback for a bucket that would not answer a range request.
        ...(size ? { width: size.width, height: size.height } : { inferSize: true as const }),
        widths: ladderWidths,
        format,
        quality: QUALITY,
      })
    )
  );
  return {
    width: w,
    height: h,
    avif: avif.srcSet.attribute,
    webp: webp.srcSet.attribute,
    fallback: {
      src: fallback.src,
      srcset: fallback.srcSet.attribute,
      type: `image/${fallbackFormat}`,
    },
  };
};

// ---- pre-built ladder -----------------------------------------------------
// Either produced by the site's prerendered manifest endpoint (an on-demand
// site, see setImageLadder) or, for an R2 image on a prerendered site, encoded
// right here. Both arrive in the same shape, so everything below this line is
// blind to which one it got.
const built =
  ladderFor(src) ??
  (remoteUrl && canBuildRemote(remoteUrl)
    ? await remoteLadder(remoteUrl, width, height, variant)
    : undefined);

const mobileBuilt = mobileSrc
  ? (ladderFor(mobileSrc) ??
    (mobileRemoteUrl && canBuildRemote(mobileRemoteUrl)
      ? await remoteLadder(mobileRemoteUrl, mWidth, mHeight, mVariant)
      : undefined))
  : undefined;

// ---- art-directed branch --------------------------------------------------
// Either side may be a repo asset or a bucket object, and a site mid-migration
// will have one of each — so the test is "both sides resolved", not "both sides
// resolved the same way".
const artDirected = Boolean((image || built) && (mobileImage || mobileBuilt));

const buildSources = async (
  img: ImageMetadata,
  w: number,
  h: number,
  v: PictureVariant,
  formats: readonly string[] = FORMATS
) =>
  Promise.all(
    formats.map(async (format) => {
      const built = await getImage({
        src: img,
        width: w,
        height: h,
        widths: widthsFor(v, w),
        format: format as 'avif',
        quality: QUALITY,
      });
      return { srcset: built.srcSet.attribute, type: `image/${format}` };
    })
  );

// The mobile branch carries its own fallback format — the <img> below only ever
// holds the desktop crop, so without it a no-AVIF/WebP browser would fall back
// to the wrong art direction.
/** The three `<source>`s for a pre-built entry, mobile branch included. */
const builtSources = (entry: NonNullable<typeof built>) => [
  { srcset: entry.avif, type: 'image/avif' },
  { srcset: entry.webp, type: 'image/webp' },
  { srcset: entry.fallback.srcset, type: entry.fallback.type },
];

const mobileSources = !artDirected
  ? []
  : mobileBuilt
    ? builtSources(mobileBuilt)
    : await buildSources(mobileImage!, mWidth, mHeight, mVariant, [
        ...FORMATS,
        fallbackFor(mobileImage!),
      ]);

const desktopSources = !artDirected
  ? []
  : built
    ? builtSources(built).slice(0, 2) // the <img> below carries the fallback
    : await buildSources(image!, width, height, variant);

const fallback = !artDirected
  ? null
  : built
    ? { src: built.fallback.src, srcSet: { attribute: built.fallback.srcset } }
    : await getImage({
        src: image!,
        width,
        height,
        widths,
        format: fallbackFor(image!),
        quality: QUALITY,
      });
---

{
  artDirected ? (
    <picture class={pictureClass} {...cidAttrs}>
      {mobileSources.map((s) => (
        <source media={mobileMedia} srcset={s.srcset} type={s.type} sizes={mSizes} />
      ))}
      {desktopSources.map((s) => (
        <source srcset={s.srcset} type={s.type} sizes={resolvedSizes} />
      ))}
      <img
        src={fallback!.src}
        srcset={fallback!.srcSet.attribute || undefined}
        sizes={resolvedSizes}
        alt={alt}
        width={width}
        height={height}
        class={className}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
        aria-hidden={ariaHidden ? 'true' : undefined}
        {...cidAttrs}
      />
    </picture>
  ) : built ? (
    <picture class={pictureClass} {...cidAttrs}>
      <source srcset={built.avif} type="image/avif" sizes={resolvedSizes} />
      <source srcset={built.webp} type="image/webp" sizes={resolvedSizes} />
      <img
        src={built.fallback.src}
        srcset={built.fallback.srcset || undefined}
        sizes={resolvedSizes}
        alt={alt}
        width={width}
        height={height}
        class={className}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
        aria-hidden={ariaHidden ? 'true' : undefined}
        {...cidAttrs}
      />
    </picture>
  ) : image ? (
    <Picture
      {...cidAttrs}
      src={image}
      alt={alt}
      width={width}
      height={height}
      widths={widths}
      sizes={resolvedSizes}
      formats={['avif', 'webp']}
      fallbackFormat={fallbackFor(image)}
      quality={QUALITY}
      class={className}
      pictureAttributes={pictureClass ? { class: pictureClass } : undefined}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      aria-hidden={ariaHidden ? 'true' : undefined}
    />
  ) : (
    <img
      src={remoteUrl ?? (typeof src === 'string' ? src : undefined)}
      alt={alt}
      width={width}
      height={height}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      sizes={sizes}
      aria-hidden={ariaHidden ? 'true' : undefined}
      {...cidAttrs}
    />
  )
}
