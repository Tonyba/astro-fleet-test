
# Copy to .env for local development, and set the same values as Cloudflare
# Pages secrets for production.

# ---------------------------------------------------------------------------
# Keystatic — GitHub mode (production only; `astro dev` uses local storage)
# ---------------------------------------------------------------------------
# These four are generated for you: deploy the site, open /keystatic, and walk
# through "Create GitHub App". Paste the values it prints here and into the
# Pages project settings.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=keystatic-kv

# ---------------------------------------------------------------------------
# Form submissions — /api/quote
# ---------------------------------------------------------------------------
# Turnstile SECRET key (worker-side verification). Pair it with the site key
# below: a secret with no site key rejects every submission, because the form
# would post no token.
TURNSTILE_SECRET=
# Turnstile SITE key (public, rendered in the page). The committed CMS value in
# src/content/settings/site.json -> business.technical.turnstileSiteKey is the
# real source of truth so CI builds have it; set this only to override locally
# (e.g. Cloudflare's always-passes test key 1x00000000000000000000AA).
PUBLIC_TURNSTILE_SITE_KEY=
# Repo-scoped token used to commit leads to src/content/submissions/.
# Omit and leads are logged to the worker console instead of committed.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=

# ---------------------------------------------------------------------------
# Lead notification email — Brevo (see src/lib/notify.ts)
# ---------------------------------------------------------------------------
# v3 API key from Brevo -> SMTP & API -> API Keys. Omit and no email is sent;
# the submission is still stored.
#
# This is the HTTP API, NOT the SMTP relay Brevo also offers: Cloudflare
# Workers have no raw TCP sockets, so an SMTP handshake cannot happen there.
BREVO_API_KEY=
# Sender address. Must be a verified sender (or on an authenticated domain) in
# that Brevo account, or Brevo rejects the send.
BREVO_FROM_EMAIL=
# Optional sender display name; defaults to the site name from Site Settings.
BREVO_FROM_NAME=
