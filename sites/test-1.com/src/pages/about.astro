---
// Rendered per request: that is what lets a CMS edit appear without a build.
export const prerender = false;

import '../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreePageHero from '@astro-fleet/shared-ui/src/components/TreePageHero.astro';
import TreeServiceIntro from '@astro-fleet/shared-ui/src/components/TreeServiceIntro.astro';
import TreeStatsBar from '@astro-fleet/shared-ui/src/components/TreeStatsBar.astro';
import TreeApproach from '@astro-fleet/shared-ui/src/components/TreeApproach.astro';
import TreeMission from '@astro-fleet/shared-ui/src/components/TreeMission.astro';
import TreeCoreValues from '@astro-fleet/shared-ui/src/components/TreeCoreValues.astro';
import TreeCtaBanner from '@astro-fleet/shared-ui/src/components/TreeCtaBanner.astro';
import TreeWhyChoose from '@astro-fleet/shared-ui/src/components/TreeWhyChoose.astro';
import TreeServiceAreas from '@astro-fleet/shared-ui/src/components/TreeServiceAreas.astro';
import TreeFaq from '@astro-fleet/shared-ui/src/components/TreeFaq.astro';
import TreeInspectionForm from '@astro-fleet/shared-ui/src/components/TreeInspectionForm.astro';

import { getForm } from '../lib/forms';
import { resolveSeo } from '../lib/seo';
import { getHeader } from '../lib/header';

// CMS-editable content (Keystatic commits these JSON files; the build imports them).
import { getDoc, siteSettings, chromeSettings, globalSections } from '../lib/runtime-content';

// Settings for this request; middleware refreshed them before we got here.
const site = siteSettings();
const chrome = chromeSettings();
const globals = globalSections();
const home = await getDoc("homepage/home");
const page = await getDoc("pages/about");

const quoteForm = await getForm('quote');

const seo = resolveSeo({
  pattern: 'about',
  title: page.seo.title,
  description: page.seo.description,
  path: Astro.url.pathname,
});

// The Areas We Serve submenu is generated from the Service Areas content.
const header = await getHeader();

---

<TreeLayout
  title={seo.title}
  description={seo.description}
  keywords={page.seo.keywords}
  siteName={site.siteName}
  logoSrc={site.logo}
  faviconSrc={site.favicon}
  header={header}
  footer={chrome.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  <TreePageHero {...page.hero} />

  {/* "Our Story" is the same block as a service page's intro, plus an eyebrow. */}
  <TreeServiceIntro {...page.story} />

  {/* Standalone here — the pill's homepage overlap would eat the 72px gap
      the design leaves above "Our Approach". */}
  <TreeStatsBar
    eyebrow={page.stats.eyebrow}
    heading={page.stats.heading}
    stats={page.stats.items}
    overlap={false}
  />

  <TreeApproach {...page.approach} />
  <TreeMission {...page.mission} />
  <TreeCoreValues
    eyebrow={page.coreValues.eyebrow}
    heading={page.coreValues.heading}
    values={page.coreValues.items}
  />

  <TreeCtaBanner {...home.ctaBanner} />
  <TreeWhyChoose
    eyebrow={home.whyChoose.eyebrow}
    heading={home.whyChoose.heading}
    items={home.whyChoose.items}
  />
  <TreeServiceAreas
    eyebrow={globals.serviceAreas.eyebrow}
    heading={globals.serviceAreas.heading}
    description={globals.serviceAreas.description}
    areasLabel={globals.serviceAreas.areasLabel}
    areas={globals.serviceAreas.areas}
    ctaText={globals.serviceAreas.ctaText}
  />
  <TreeFaq
    eyebrow={globals.faq.eyebrow}
    titleLead={globals.faq.titleLead}
    titleRest={globals.faq.titleRest}
    subtitle={globals.faq.subtitle}
    faqs={globals.faq.items}
  />
  <TreeInspectionForm
    heading={globals.inspection.heading}
    lead={globals.inspection.lead}
    paragraphs={globals.inspection.paragraphs}
    quote={quoteForm}
  />
</TreeLayout>
