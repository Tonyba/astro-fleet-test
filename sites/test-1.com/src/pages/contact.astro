---
// Rendered per request: that is what lets a CMS edit appear without a build.
export const prerender = false;

import '../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreePageHero from '@astro-fleet/shared-ui/src/components/TreePageHero.astro';
import TreeQuoteForm from '@astro-fleet/shared-ui/src/components/TreeQuoteForm.astro';
import TreeContactDetails from '@astro-fleet/shared-ui/src/components/TreeContactDetails.astro';

import { getForm } from '../lib/forms';
import { resolveSeo } from '../lib/seo';
import { getHeader } from '../lib/header';

// CMS-editable content (Keystatic commits these JSON files; the build imports them).
import { getDoc, siteSettings } from '../lib/runtime-content';

// Settings for this request; middleware refreshed them before we got here.
const site = siteSettings();
const page = await getDoc("pages/contact");

// Same form model every other page uses — one definition, reused.
const quoteForm = await getForm('quote');

const seo = resolveSeo({
  pattern: 'contact',
  title: page.seo.title,
  description: page.seo.description,
  path: Astro.url.pathname,
});

// The Areas We Serve submenu is generated from the Service Areas content.
const header = await getHeader();

---

<TreeLayout
  title={seo.title}
  description={seo.description}
  keywords={page.seo.keywords}
  siteName={site.siteName}
  logoSrc={site.logo}
  faviconSrc={site.favicon}
  header={header}
  footer={site.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  {/*
    The contact form sits inside the hero band, reversed out over the dark
    panel with the photo alongside (Figma 123:2055 + 123:2085). The heading and
    intro stay on the hero so the page keeps a real <h1>; the form renders
    header-less beneath them.
  */}
  <TreePageHero {...page.hero} titleSize="36px" titleTransform="uppercase">
    <TreeQuoteForm
      {...quoteForm}
      variant="inverse"
      showHeader={false}
      formName="contact"
      id="contact"
    />
  </TreePageHero>

  <TreeContactDetails {...page.details} />
</TreeLayout>
