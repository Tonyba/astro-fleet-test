---
// Rendered per request: that is what lets a CMS edit appear without a build.
export const prerender = false;

import '../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreeHero from '@astro-fleet/shared-ui/src/components/TreeHero.astro';
import TreeTrustBar from '@astro-fleet/shared-ui/src/components/TreeTrustBar.astro';
import TreeServices from '@astro-fleet/shared-ui/src/components/TreeServices.astro';
import TreeWhyChoose from '@astro-fleet/shared-ui/src/components/TreeWhyChoose.astro';
import TreeCtaBanner from '@astro-fleet/shared-ui/src/components/TreeCtaBanner.astro';
import TreeAbout from '@astro-fleet/shared-ui/src/components/TreeAbout.astro';
import TreeStatsBar from '@astro-fleet/shared-ui/src/components/TreeStatsBar.astro';
import TreeCommercial from '@astro-fleet/shared-ui/src/components/TreeCommercial.astro';
import TreeProjects from '@astro-fleet/shared-ui/src/components/TreeProjects.astro';
import TreeEmergencyBanner from '@astro-fleet/shared-ui/src/components/TreeEmergencyBanner.astro';
import TreeProcess from '@astro-fleet/shared-ui/src/components/TreeProcess.astro';
import TreeTestimonials from '@astro-fleet/shared-ui/src/components/TreeTestimonials.astro';
import TreeServiceAreas from '@astro-fleet/shared-ui/src/components/TreeServiceAreas.astro';
import TreeFaq from '@astro-fleet/shared-ui/src/components/TreeFaq.astro';
import TreeBlogPreview from '@astro-fleet/shared-ui/src/components/TreeBlogPreview.astro';
import TreeInspectionForm from '@astro-fleet/shared-ui/src/components/TreeInspectionForm.astro';

import { getForm } from '../lib/forms';
import { getServiceCards } from '../lib/services';
import { resolveSeo } from '../lib/seo';
import { getHeader } from '../lib/header';

// CMS-editable content (Keystatic commits these JSON files; the build imports them).
import { getDoc, listPublished, siteSettings, chromeSettings, globalSections } from '../lib/runtime-content';

// Settings for this request; middleware refreshed them before we got here.
const site = siteSettings();
const chrome = chromeSettings();
const globals = globalSections();
const home = await getDoc("homepage/home");

// Forms are their own content model — the same definition is reused by the hero
// card and the closing inspection section.
const quoteForm = await getForm('quote');

// The homepage grid shows the core tree-care services from the Single Service
// collection — same source as both /services/ pages.
const homeServices = await getServiceCards({ group: 'tree-care' });

// Blog preview — pulled from the CMS `posts` collection (latest 3, non-draft).
const dateFmt = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
const blogPosts = (await listPublished('posts'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    excerpt: post.data.description ?? '',
    date: dateFmt(new Date(post.data.date)),
    href: `/blog/${post.slug}/`,
    image: post.data.image ?? '/src/assets/photos/blog-tree-power-lines.jpg',
    imageAlt: post.data.imageAlt ?? post.data.title,
  }));

// Title comes from the CMS "home" pattern; the page's own title is the fallback.
const seo = resolveSeo({
  pattern: 'home',
  title: home.seo.title,
  description: home.seo.description,
  path: Astro.url.pathname,
});

// The Areas We Serve submenu is generated from the Service Areas content.
const header = await getHeader();

---

<TreeLayout
  title={seo.title}
  description={seo.description}
  keywords={home.seo.keywords}
  siteName={site.siteName}
  logoSrc={site.logo}
  faviconSrc={site.favicon}
  header={header}
  footer={chrome.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  <TreeHero {...home.hero} quote={quoteForm} />
  <TreeTrustBar {...globals.trustBar} />
  <TreeServices eyebrow={home.services.eyebrow} heading={home.services.heading} services={homeServices} viewAllHref="/services/residential/" />
  <TreeWhyChoose eyebrow={home.whyChoose.eyebrow} heading={home.whyChoose.heading} items={home.whyChoose.items} />
  <TreeCtaBanner {...home.ctaBanner} />
  <TreeAbout {...home.about} />
  <TreeStatsBar eyebrow={home.stats.eyebrow} heading={home.stats.heading} stats={home.stats.items} />
  <TreeCommercial {...home.commercial} />
  <TreeProjects eyebrow={globals.projects.eyebrow} heading={globals.projects.heading} description={globals.projects.description} projects={globals.projects.items} />
  <TreeEmergencyBanner {...globals.emergency} />
  <TreeProcess eyebrow={home.process.eyebrow} heading={home.process.heading} description={home.process.description} steps={home.process.steps} />
  <TreeTestimonials eyebrow={globals.testimonials.eyebrow} heading={globals.testimonials.heading} description={globals.testimonials.description} rating={globals.testimonials.rating} reviews={globals.testimonials.reviews} />
  <TreeServiceAreas
    eyebrow={globals.serviceAreas.eyebrow}
    heading={globals.serviceAreas.heading}
    description={globals.serviceAreas.description}
    areasLabel={globals.serviceAreas.areasLabel}
    areas={globals.serviceAreas.areas}
    ctaText={globals.serviceAreas.ctaText}
  />
  <TreeFaq eyebrow={globals.faq.eyebrow} titleLead={globals.faq.titleLead} titleRest={globals.faq.titleRest} faqs={globals.faq.items} />
  <TreeBlogPreview eyebrow={home.blog.eyebrow} title={home.blog.title} posts={blogPosts.length ? blogPosts : undefined} />
  <TreeInspectionForm heading={globals.inspection.heading} lead={globals.inspection.lead} paragraphs={globals.inspection.paragraphs} quote={quoteForm} />
</TreeLayout>
