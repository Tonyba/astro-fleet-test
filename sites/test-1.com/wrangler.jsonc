{
  // ---------------------------------------------------------------------------
  // test-1.com — the runtime-content variant of test-2.com
  // ---------------------------------------------------------------------------
  // Same site, same CMS, one difference: pages render per request and read their
  // content from CONTENT instead of from files baked in at build time. A
  // Keystatic save reaches this namespace through the GitHub webhook in
  // src/pages/api/content-sync.ts, so an edit is live in seconds with no build.
  //
  // The Astro adapter generates dist/server/wrangler.json for the deploy and
  // uses this file as its base, so anything it would otherwise supply by default
  // has to be stated here — `observability` in particular is silently dropped
  // once a user config exists.
  //
  // The SESSION namespace the adapter adds for Astro sessions is deliberately
  // absent: it is auto-provisioned on deploy and must not be pinned.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test-1-com",
  "compatibility_date": "2026-08-13",

  "observability": { "enabled": true },

  // Content is read from D1, not KV. KV reads are cached at the edge for 30-60
  // seconds and cannot be read fresher — Cloudflare's docs advise against KV
  // when a write has to be visible shortly after it is made — so a CMS edit
  // took up to a minute to appear. D1 is single-primary SQLite with strongly
  // consistent reads: the row the webhook writes is visible to the next
  // request. See db/schema.sql.
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "test-1-content",
      "database_id": "5a0f7bd3-28f7-44ef-afd1-c65bfdef7384"
    }
  ],

  // CMS-uploaded photographs. The worker only WRITES here (POST /api/media);
  // the site reads them from the bucket's public origin, set in Site Settings
  // -> Technical -> Media Bucket URL. Create it before the first deploy:
  //   wrangler r2 bucket create test-1-com-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "test-1-com-media"
    }
  ]
}
