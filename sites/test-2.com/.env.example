# Copy to .env for local development, and set the same values as Cloudflare
# Pages secrets for production.

# ---------------------------------------------------------------------------
# Keystatic — GitHub mode (production only; `astro dev` uses local storage)
# ---------------------------------------------------------------------------
# These four are generated for you: deploy the site, open /keystatic, and walk
# through "Create GitHub App". Paste the values it prints here and into the
# Pages project settings.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# Form submissions — /api/quote
# ---------------------------------------------------------------------------
# Turnstile secret key. Omit to disable the spam check (the form still works).
TURNSTILE_SECRET=
# Repo-scoped token used to commit leads to src/content/submissions/.
# Omit and leads are logged to the worker console instead of committed.
GITHUB_TOKEN=
GITHUB_REPO=tonyba/astro-fleet-test
GITHUB_BRANCH=staging
