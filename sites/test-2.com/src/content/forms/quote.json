{
  "name": "Quote Request",
  "title": "Get Your Free Quote",
  "subtitle": "Tell us about your project and we'll get back to you within 24 hours.",
  "submitText": "Get Free Quote Now",
  "action": "/api/quote",
  "fields": [
    {
      "name": "full_name",
      "type": "text",
      "label": "Full Name",
      "placeholder": "Full Name*",
      "required": true
    },
    {
      "name": "email",
      "type": "email",
      "label": "Email Address",
      "placeholder": "Email Adress*",
      "required": true
    },
    {
      "name": "phone",
      "type": "tel",
      "label": "Phone Number",
      "placeholder": "Phone Number*",
      "required": true
    },
    {
      "name": "project_type",
      "type": "radio",
      "label": "Proyect Type",
      "placeholder": "",
      "required": false,
      "options": [
        "Residential",
        "Commercial"
      ]
    },
    {
      "name": "service",
      "type": "select",
      "label": "What service do you need?",
      "placeholder": "",
      "required": false,
      "options": [
        "Tree Removal Services",
        "Tree Trimming & Pruning",
        "Stump Grinding",
        "Land Clearing & Lot Cleaning",
        "Storm Damage Cleanup",
        "Cabling & Bracing"
      ]
    },
    {
      "name": "message",
      "type": "textarea",
      "label": "Project details",
      "placeholder": "Tell us about your project...",
      "required": false
    }
  ]
}
