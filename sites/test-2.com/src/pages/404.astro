---
import '../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreePageHero from '@astro-fleet/shared-ui/src/components/TreePageHero.astro';
import TreeCtaBanner from '@astro-fleet/shared-ui/src/components/TreeCtaBanner.astro';

// CMS-editable content (Keystatic commits these JSON files; the build imports them).
import site from '../content/settings/site.json';
import home from '../content/homepage/home.json';
import page from '../content/pages/404.json';
import { resolveSeo } from '../lib/seo';
import { getHeader } from '../lib/header';

const { body } = page;

const seo = resolveSeo({
  title: page.seo.title,
  description: page.seo.description,
  path: '/404/',
});

// The Areas We Serve submenu is generated from the Service Areas content.
const header = await getHeader();
---

<TreeLayout
  title={seo.title}
  description={seo.description}
  keywords={page.seo.keywords}
  siteName={site.siteName}
  logoSrc={site.logo}
  faviconSrc={site.favicon}
  header={header}
  footer={site.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  <TreePageHero {...page.hero} compact />

  <section class="tree-404">
    <div class="tree-container tree-404__inner">
      <p class="tree-404__code">{body.code}</p>
      <h2 class="tree-404__heading">{body.heading}</h2>
      <p class="tree-404__desc">{body.description}</p>

      <div class="tree-404__actions">
        {
          body.primaryCta.label && (
            <a href={body.primaryCta.href} class="tree-404__btn tree-404__btn--solid">
              {body.primaryCta.label}
            </a>
          )
        }
        {
          body.secondaryCta.label && (
            <a href={body.secondaryCta.href} class="tree-404__btn tree-404__btn--outline">
              {body.secondaryCta.label}
            </a>
          )
        }
      </div>

      {
        body.links.length > 0 && (
          <div class="tree-404__links">
            {body.linksHeading && <p class="tree-404__links-heading">{body.linksHeading}</p>}
            <ul class="tree-404__links-list">
              {body.links.map((link) => (
                <li>
                  <a href={link.href} class="tree-404__link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <TreeCtaBanner {...home.ctaBanner} />
</TreeLayout>

<style>
  .tree-404 {
    background: var(--color-bg-surface, #fff);
    padding-block: 96px;
  }

  .tree-404__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
  }

  .tree-404__code {
    font-family: var(--font-heading);
    font-size: 120px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-bg-brand-soft, #e5f1ed);
  }

  .tree-404__heading {
    margin-top: 8px;
    font-size: 42px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text-primary, #013b2d);
  }

  .tree-404__desc {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.8;
    color: var(--color-text-secondary, #373434);
  }

  .tree-404__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }

  .tree-404__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 60px;
    padding-inline: 32px;
    border-radius: var(--tree-radius-btn, 6px);
    font-size: 18px;
    line-height: 1.8;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .tree-404__btn--solid {
    font-weight: 700;
    text-transform: capitalize;
    background: var(--color-bg-action, #2f8328);
    color: var(--color-text-inverse, #fff);
  }
  .tree-404__btn--solid:hover {
    background: var(--color-bg-action-hover, #368a2a);
  }

  .tree-404__btn--outline {
    font-weight: 600;
    text-transform: uppercase;
    border: 1px solid var(--color-border-strong, #013b2d);
    color: var(--color-text-primary, #013b2d);
  }
  .tree-404__btn--outline:hover {
    background: var(--color-text-primary, #013b2d);
    color: var(--color-text-inverse, #fff);
  }

  .tree-404__links {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border-subtle, #d9d9d9);
    width: 100%;
  }

  .tree-404__links-heading {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-primary, #013b2d);
  }

  .tree-404__links-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 32px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }

  .tree-404__link {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-text-secondary, #373434);
    border-bottom: 1px solid transparent;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .tree-404__link:hover {
    color: var(--color-bg-action, #2f8328);
    border-bottom-color: var(--color-bg-action, #2f8328);
  }

  /* ===== Tablet (<=1024px) ===== */
  @media (max-width: 1024px) {
    .tree-404 {
      padding-block: 72px;
    }
    .tree-404__code {
      font-size: 96px;
    }
    .tree-404__heading {
      font-size: 34px;
    }
    .tree-404__desc {
      font-size: 16px;
      line-height: 1.7;
    }
    .tree-404__btn {
      height: 54px;
      font-size: 16px;
      padding-inline: 28px;
    }
  }

  /* ===== Mobile (<=767px) ===== */
  @media (max-width: 767px) {
    .tree-404 {
      padding-block: 56px;
    }
    .tree-404__code {
      font-size: 72px;
    }
    .tree-404__heading {
      font-size: 30px;
    }
    .tree-404__desc {
      font-size: 15px;
    }
    .tree-404__actions {
      flex-direction: column;
      align-items: stretch;
      align-self: stretch;
      gap: 12px;
    }
    .tree-404__btn {
      width: 100%;
      height: 52px;
    }
    .tree-404__links {
      margin-top: 36px;
      padding-top: 24px;
    }
    .tree-404__links-list {
      flex-direction: column;
      gap: 12px;
    }
    .tree-404__link {
      font-size: 16px;
    }
  }
</style>
