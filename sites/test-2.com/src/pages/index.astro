---
import '../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreeHero from '@astro-fleet/shared-ui/src/components/TreeHero.astro';
import TreeTrustBar from '@astro-fleet/shared-ui/src/components/TreeTrustBar.astro';
import TreeServices from '@astro-fleet/shared-ui/src/components/TreeServices.astro';
import TreeWhyChoose from '@astro-fleet/shared-ui/src/components/TreeWhyChoose.astro';
import TreeCtaBanner from '@astro-fleet/shared-ui/src/components/TreeCtaBanner.astro';
import TreeAbout from '@astro-fleet/shared-ui/src/components/TreeAbout.astro';
import TreeStatsBar from '@astro-fleet/shared-ui/src/components/TreeStatsBar.astro';
import TreeCommercial from '@astro-fleet/shared-ui/src/components/TreeCommercial.astro';
import TreeProjects from '@astro-fleet/shared-ui/src/components/TreeProjects.astro';
import TreeEmergencyBanner from '@astro-fleet/shared-ui/src/components/TreeEmergencyBanner.astro';
import TreeProcess from '@astro-fleet/shared-ui/src/components/TreeProcess.astro';
import TreeTestimonials from '@astro-fleet/shared-ui/src/components/TreeTestimonials.astro';
import TreeServiceAreas from '@astro-fleet/shared-ui/src/components/TreeServiceAreas.astro';
import TreeFaq from '@astro-fleet/shared-ui/src/components/TreeFaq.astro';
import TreeBlogPreview from '@astro-fleet/shared-ui/src/components/TreeBlogPreview.astro';
import TreeInspectionForm from '@astro-fleet/shared-ui/src/components/TreeInspectionForm.astro';

import { getCollection } from 'astro:content';

// CMS-editable content (Sveltia commits these JSON files; the build imports them).
import site from '../content/settings/site.json';
import home from '../content/homepage/home.json';

// Blog preview — pulled from the CMS `posts` collection (latest 3, non-draft).
const dateFmt = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
const blogPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    excerpt: post.data.description ?? '',
    date: dateFmt(post.data.date),
    href: `/blog/${post.id.replace(/\.md$/, '')}/`,
    image: post.data.image ?? '/media/photos/blog-tree-power-lines.jpg',
    imageAlt: post.data.imageAlt ?? post.data.title,
  }));
---

<TreeLayout
  title={home.seo.title}
  description={home.seo.description}
  keywords={home.seo.keywords}
  siteName={site.siteName}
  logoSrc={site.logo}
  header={site.header}
  footer={site.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  <TreeHero {...home.hero} quote={site.forms.quote} />
  <TreeTrustBar />
  <TreeServices eyebrow={home.services.eyebrow} heading={home.services.heading} services={home.services.items} />
  <TreeWhyChoose eyebrow={home.whyChoose.eyebrow} heading={home.whyChoose.heading} items={home.whyChoose.items} />
  <TreeCtaBanner {...home.ctaBanner} />
  <TreeAbout />
  <TreeStatsBar eyebrow={home.stats.eyebrow} heading={home.stats.heading} stats={home.stats.items} />
  <TreeCommercial />
  <TreeProjects eyebrow={home.projects.eyebrow} heading={home.projects.heading} description={home.projects.description} projects={home.projects.items} />
  <TreeEmergencyBanner {...home.emergency} />
  <TreeProcess eyebrow={home.process.eyebrow} heading={home.process.heading} description={home.process.description} steps={home.process.steps} />
  <TreeTestimonials eyebrow={home.testimonials.eyebrow} heading={home.testimonials.heading} description={home.testimonials.description} rating={home.testimonials.rating} reviews={home.testimonials.reviews} />
  <TreeServiceAreas
    eyebrow={home.serviceAreas.eyebrow}
    heading={home.serviceAreas.heading}
    description={home.serviceAreas.description}
    areasLabel={home.serviceAreas.areasLabel}
    areas={home.serviceAreas.areas}
    ctaText={home.serviceAreas.ctaText}
  />
  <TreeFaq eyebrow={home.faq.eyebrow} titleLead={home.faq.titleLead} titleRest={home.faq.titleRest} faqs={home.faq.items} />
  <TreeBlogPreview eyebrow={home.blog.eyebrow} title={home.blog.title} posts={blogPosts.length ? blogPosts : undefined} />
  <TreeInspectionForm heading={home.inspection.heading} lead={home.inspection.lead} paragraphs={home.inspection.paragraphs} quote={site.forms.quote} />
</TreeLayout>
