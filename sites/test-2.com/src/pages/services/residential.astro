---
import '../../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreePageHero from '@astro-fleet/shared-ui/src/components/TreePageHero.astro';
import TreeStatsRow from '@astro-fleet/shared-ui/src/components/TreeStatsRow.astro';
import TreeServices from '@astro-fleet/shared-ui/src/components/TreeServices.astro';
import TreeEmergencyBanner from '@astro-fleet/shared-ui/src/components/TreeEmergencyBanner.astro';
import TreeProjects from '@astro-fleet/shared-ui/src/components/TreeProjects.astro';
import TreeFaq from '@astro-fleet/shared-ui/src/components/TreeFaq.astro';
import TreeInspectionForm from '@astro-fleet/shared-ui/src/components/TreeInspectionForm.astro';

import { getForm } from '../../lib/forms';

// CMS-editable content (Sveltia commits these JSON files; the build imports them).
import site from '../../content/settings/site.json';
import page from '../../content/pages/services-residential.json';

// Same form model the rest of the site uses — one definition, reused per page.
const quoteForm = await getForm('quote');
---

<TreeLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  siteName={site.siteName}
  logoSrc={site.logo}
  header={site.header}
  footer={site.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  <TreePageHero {...page.hero} />
  <TreeStatsRow stats={page.stats} />

  {/*
    Two card grids stacked inside one Figma "Services List" section (123:2243):
    the tree-care six, then the outdoor-solutions seven. Both are the same card,
    so both are TreeServices — only the heading and items differ.
  */}
  <TreeServices
    heading={page.services.heading}
    services={page.services.items}
    eyebrow=""
    align="left"
    showViewAll={false}
    spacing="group-start"
  />
  <TreeServices
    heading={page.outdoor.heading}
    services={page.outdoor.items}
    eyebrow=""
    align="left"
    showViewAll={false}
    spacing="group-end"
    headingWidth="1029px"
  />

  <TreeEmergencyBanner {...page.emergency} />
  <TreeProjects
    eyebrow={page.projects.eyebrow}
    heading={page.projects.heading}
    description={page.projects.description}
    projects={page.projects.items}
  />
  <TreeFaq
    eyebrow={page.faq.eyebrow}
    titleLead={page.faq.titleLead}
    titleRest={page.faq.titleRest}
    subtitle={page.faq.subtitle}
    faqs={page.faq.items}
  />
  <TreeInspectionForm
    heading={page.inspection.heading}
    lead={page.inspection.lead}
    paragraphs={page.inspection.paragraphs}
    quote={quoteForm}
  />
</TreeLayout>
