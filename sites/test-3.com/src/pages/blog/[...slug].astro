---
import '../../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreePicture from '@astro-fleet/shared-ui/src/components/TreePicture.astro';
import TreeInspectionForm from '@astro-fleet/shared-ui/src/components/TreeInspectionForm.astro';

import { getCollection, render } from 'astro:content';
import { getForm } from '../../lib/forms';
import { resolveSeo } from '../../lib/seo';
import { getHeader } from '../../lib/header';

import site from '../../content/settings/site.json';
import chrome from '../../content/settings/header-footer.json';
import blog from '../../content/pages/blog.json';
import { globals } from '../../lib/global-sections';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const quoteForm = await getForm('quote');

// Same DD/MM/YYYY the listing uses.
const dateLabel = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
}).format(post.data.date);

const seo = resolveSeo({
  pattern: 'post',
  tokens: { title: post.data.title },
  title: `${post.data.title} — ${site.siteName}`,
  description: post.data.description ?? post.data.title,
  path: Astro.url.pathname,
});

// The Areas We Serve submenu is generated from the Service Areas content.
const header = await getHeader();
---

<TreeLayout
  title={seo.title}
  description={seo.description}
  siteName={site.siteName}
  logoSrc={site.logo}
  faviconSrc={site.favicon}
  header={header}
  footer={chrome.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  <article class="post">
    <div class="tree-container post__inner">
      <nav class="post__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a>
      </nav>

      <header class="post__header">
        <span class="post__date">
          <img src="/media/icons/blog-calendar.svg" alt="" width="22" height="22" aria-hidden="true" />
          <time datetime={post.data.date.toISOString()}>{dateLabel}</time>
        </span>
        <h1 class="post__title">{post.data.title}</h1>
        {post.data.description && <p class="post__lead">{post.data.description}</p>}
      </header>

      <TreePicture
        class="post__cover"
        src={post.data.image ?? blog.fallbackImage}
        alt={post.data.imageAlt ?? post.data.title}
        width={952}
        height={570}
        variant="hero"
        sizes="(max-width: 1024px) 100vw, 952px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <div class="post__prose">
        <Content />
      </div>

      <footer class="post__footer">
        <a class="post__back" href="/blog/">← Back to blog</a>
      </footer>
    </div>
  </article>

  <TreeInspectionForm
    heading={globals.inspection.heading}
    lead={globals.inspection.lead}
    paragraphs={globals.inspection.paragraphs}
    quote={quoteForm}
  />
</TreeLayout>

<style>
  /* Typography follows the Tree tokens (fonts come from TreeLayout), so the
     article reads as part of the same site as every other page. */
  .post { padding-block: 76px 90px; background: var(--color-bg-surface, #fff); }
  /* No local width cap — .tree-container governs, same as every other page. */
  .post__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 30px; }

  .post__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-secondary, #373434);
  }
  .post__crumbs a { color: var(--color-text-primary, #013b2d); }
  .post__crumbs a:hover { text-decoration: underline; }

  .post__header { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }

  .post__date {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 6px;
    background: var(--color-bg-action, #2f8328);
    color: var(--color-text-inverse, #fff);
    font-size: 16px;
    font-weight: 600;
  }
  .post__date img { width: 22px; height: 22px; }

  .post__title {
    font-size: 42px;
    font-weight: 500;
    line-height: 1.248;
    color: var(--color-text-primary, #013b2d);
  }
  .post__lead { font-size: 18px; line-height: 1.66; color: var(--color-text-secondary, #373434); }

  .post__inner > :global(picture) { display: contents; }
  .post__inner :global(.post__cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 952 / 570;
    object-fit: cover;
    border-radius: var(--tree-radius-card, 12px);
  }

  .post__prose { width: 100%; }
  .post__prose :global(h2) {
    font-size: 30px; font-weight: 500; line-height: 1.248;
    color: var(--color-bg-brand-strong, #1e372e); margin-top: 40px;
  }
  .post__prose :global(h3) {
    font-size: 24px; font-weight: 600; line-height: 1.3;
    color: var(--color-bg-brand-strong, #1e372e); margin-top: 32px;
  }
  .post__prose :global(p),
  .post__prose :global(li) { font-size: 18px; line-height: 1.66; color: var(--color-text-secondary, #373434); }
  .post__prose :global(h2 + p),
  .post__prose :global(h3 + p) { margin-top: 12px; }
  .post__prose :global(p + p) { margin-top: 1.66em; }
  .post__prose :global(ul),
  .post__prose :global(ol) { margin: 1.66em 0 0 1.25em; display: flex; flex-direction: column; gap: 0.6em; }
  .post__prose :global(a) { color: var(--color-bg-action, #2f8328); text-decoration: underline; }
  .post__prose :global(strong) { color: var(--color-text-primary, #013b2d); }
  .post__prose :global(img) { max-width: 100%; height: auto; border-radius: var(--tree-radius-card, 12px); }
  .post__prose :global(blockquote) {
    margin: 1.66em 0 0;
    padding: 16px 24px;
    border-left: 4px solid var(--color-bg-accent, #c8f08f);
    background: var(--color-bg-muted, #f5f6f7);
  }

  .post__footer { width: 100%; padding-top: 24px; border-top: 1px solid var(--color-border-subtle, #d9d9d9); }
  .post__back { font-size: 18px; font-weight: 600; color: var(--color-text-primary, #013b2d); }
  .post__back:hover { text-decoration: underline; }

  @media (max-width: 1024px) {
    .post { padding-block: 56px 64px; }
    .post__title { font-size: 34px; }
  }

  @media (max-width: 767px) {
    .post { padding-block: 40px 48px; }
    .post__inner { gap: 24px; }
    .post__title { font-size: 28px; }
    .post__lead { font-size: 15px; }
    .post__prose :global(h2) { font-size: 24px; }
    .post__prose :global(h3) { font-size: 20px; }
    .post__prose :global(p),
    .post__prose :global(li) { font-size: 15px; }
  }
</style>
