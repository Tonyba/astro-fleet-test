---
import '../../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreePageHero from '@astro-fleet/shared-ui/src/components/TreePageHero.astro';
import TreeBlogPreview from '@astro-fleet/shared-ui/src/components/TreeBlogPreview.astro';
import TreeInspectionForm from '@astro-fleet/shared-ui/src/components/TreeInspectionForm.astro';

import { getCollection } from 'astro:content';
import { getForm } from '../../lib/forms';
import { resolveSeo } from '../../lib/seo';
import { getHeader } from '../../lib/header';

// CMS-editable content (Keystatic commits these JSON files; the build imports them).
import site from '../../content/settings/site.json';
import chrome from '../../content/settings/header-footer.json';
import page from '../../content/pages/blog.json';
import { globals } from '../../lib/global-sections';

const quoteForm = await getForm('quote');

// Every post authored under Blog Posts in the CMS, newest first.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// The design dates read DD/MM/YYYY.
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);

const toCard = (entry: (typeof posts)[number]) => ({
  title: entry.data.title,
  excerpt: entry.data.description ?? '',
  date: formatDate(entry.data.date),
  href: `/blog/${entry.id.replace(/\.md$/, '')}/`,
  image: entry.data.image ?? page.fallbackImage,
  imageAlt: entry.data.imageAlt ?? entry.data.title,
});

// Figma splits the listing: a lead row of two, then everything else in a 3-up.
const featured = posts.slice(0, 2).map(toCard);
const rest = posts.slice(2).map(toCard);

// No site-wide pattern for the listing — this still routes through the resolver
// so a per-URL override in the CMS and the length limits apply here too.
const seo = resolveSeo({
  title: page.seo.title,
  description: page.seo.description,
  path: Astro.url.pathname,
});

// The Areas We Serve submenu is generated from the Service Areas content.
const header = await getHeader();
---

<TreeLayout
  title={seo.title}
  description={seo.description}
  keywords={page.seo.keywords}
  siteName={site.siteName}
  logoSrc={site.logo}
  faviconSrc={site.favicon}
  header={header}
  footer={chrome.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  <TreePageHero {...page.hero} compact copyGap="12px" />

  {featured.length > 0 && (
    <TreeBlogPreview
      id="recent-posts"
      title={page.recentHeading}
      eyebrow=""
      align="left"
      layout="featured"
      showViewAll={false}
      posts={featured}
    />
  )}

  {rest.length > 0 && (
    <>
      <div class="tree-container"><hr class="blog-divider" /></div>
      <TreeBlogPreview
        id="all-posts"
        title={page.allHeading}
        eyebrow=""
        align="left"
        showViewAll={false}
        posts={rest}
      />
    </>
  )}

  {posts.length === 0 && (
    <section class="blog-empty">
      <div class="tree-container"><p>{page.emptyMessage}</p></div>
    </section>
  )}

  <TreeInspectionForm
    heading={globals.inspection.heading}
    lead={globals.inspection.lead}
    paragraphs={globals.inspection.paragraphs}
    quote={quoteForm}
  />
</TreeLayout>

<style>
  /* Rule between the lead row and the full listing (Figma 123:1836). */
  .blog-divider {
    border: 0;
    border-top: 1px solid var(--color-border-subtle, #d9d9d9);
    margin: 0;
  }

  .blog-empty {
    padding-block: 100px;
    text-align: center;
    font-size: 18px;
    color: var(--color-text-secondary, #373434);
  }
</style>
