---
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import Breadcrumb from '@astro-fleet/shared-ui/src/components/Breadcrumb.astro';
import ContactForm from '@astro-fleet/shared-ui/src/components/ContactForm.astro';
import { CORPORATE } from '@astro-fleet/config/tokens';
import { getEntry } from 'astro:content';
import {
  SITE_NAME,
  TAGLINE,
  LOGO_SRC,
  LOGO_ALT,
  CTA_TEXT,
  CTA_HREF,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
} from '../lib/site-config';

// Copy lives in src/content/pages/contact.md so CloudCannon can edit it.
const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Missing src/content/pages/contact.md');
const { hero, form } = page.data;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  keywords={page.data.keywords}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  logoAlt={LOGO_ALT}
  ctaText={CTA_TEXT}
  ctaHref={CTA_HREF}
  designTokens={CORPORATE}
>
  <div class="container">
    <Breadcrumb items={page.data.breadcrumb} />
  </div>

  <!-- Page hero -->
  <section class="contact-hero section">
    <div class="container">
      <h1 class="contact-hero__title" data-editable="text" data-prop="hero.title">{hero.title}</h1>
      <p class="contact-hero__sub" data-editable="text" data-prop="hero.subtitle">
        {hero.subtitle}
      </p>
    </div>
  </section>

  <!-- Contact form -->
  <ContactForm
    formAction={form.action}
    heading={form.heading}
    description={form.description}
  />
</BaseLayout>

<style>
  .contact-hero {
    background: linear-gradient(160deg, #f0f4ff 0%, #ffffff 60%);
    padding-bottom: 0;
  }

  .contact-hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--color-primary, #1e3a5f);
    margin-bottom: 1rem;
  }

  .contact-hero__sub {
    font-size: 1.125rem;
    color: #475569;
    line-height: 1.7;
    max-width: 520px;
  }
</style>
