---
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import ServiceCard from '@astro-fleet/shared-ui/src/components/ServiceCard.astro';
import TrustBar from '@astro-fleet/shared-ui/src/components/TrustBar.astro';
import CTABlock from '@astro-fleet/shared-ui/src/components/CTABlock.astro';
import { CORPORATE } from '@astro-fleet/config/tokens';
import { getEntry } from 'astro:content';
import {
  SITE_NAME,
  TAGLINE,
  LOGO_SRC,
  LOGO_ALT,
  CTA_TEXT,
  CTA_HREF,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
} from '../lib/site-config';

// Copy lives in src/content/pages/home.md so CloudCannon can edit it.
const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.md');
const { hero, cta, features, trust_items } = page.data;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  keywords={page.data.keywords}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  logoAlt={LOGO_ALT}
  ctaText={CTA_TEXT}
  ctaHref={CTA_HREF}
  designTokens={CORPORATE}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <span class="hero__glow hero__glow--1"></span>
      <span class="hero__glow hero__glow--2"></span>
      <span class="hero__grid"></span>
    </div>
    <div class="hero__container">
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        <span data-editable="text" data-prop="hero.badge">{hero.badge}</span>
      </div>
      <h1 class="hero__headline">
        <span data-editable="text" data-prop="hero.headline">{hero.headline}</span><br />
        <span
          class="hero__headline--accent"
          data-editable="text"
          data-prop="hero.headline_accent">{hero.headline_accent}</span>
      </h1>
      <p class="hero__sub" data-editable="text" data-prop="hero.subtitle">
        {hero.subtitle}
      </p>
      <div class="hero__actions">
        <a href={hero.primary_cta.href} class="hero__cta-primary">
          <span data-editable="text" data-prop="hero.primary_cta.text">{hero.primary_cta.text}</span>
          <svg class="hero__cta-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href={hero.secondary_cta.href}
          class="hero__cta-secondary"
          data-editable="text"
          data-prop="hero.secondary_cta.text">{hero.secondary_cta.text}</a>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <TrustBar items={trust_items} />

  <!-- Features -->
  <section class="section features">
    <div class="container">
      <div class="section-header">
        <h2
          class="section-header__title"
          data-editable="text"
          data-prop="features_heading">{page.data.features_heading}</h2>
        <p
          class="section-header__description"
          data-editable="text"
          data-prop="features_description">{page.data.features_description}</p>
      </div>
      <div class="features__grid">
        {features.map((f) => (
          <ServiceCard
            title={f.title}
            description={f.description}
            href={f.href}
            linkText={f.link_text}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABlock
    heading={cta.heading}
    description={cta.description}
    primaryButton={{ text: cta.primary_button.text, href: cta.primary_button.href }}
    secondaryButton={cta.secondary_button.text
      ? { text: cta.secondary_button.text, href: cta.secondary_button.href }
      : undefined}
    variant={cta.variant as 'light' | 'dark'}
  />
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 7rem 1.5rem 5.5rem;
    text-align: center;
    color: #e5e9f0;
    background:
      radial-gradient(120% 120% at 50% -10%,
        color-mix(in srgb, var(--color-accent, #2563eb) 22%, transparent) 0%, transparent 55%),
      linear-gradient(180deg, #0a0e17 0%, #05070c 100%);
  }

  /* Decorative backdrop: soft glows + faint grid */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .hero__glow--1 {
    top: -10rem;
    left: -6rem;
    width: 26rem;
    height: 26rem;
    background: radial-gradient(circle,
      color-mix(in srgb, var(--color-accent, #2563eb) 55%, transparent), transparent 70%);
    animation: hero-float-1 14s ease-in-out infinite;
  }

  .hero__glow--2 {
    top: -6rem;
    right: -8rem;
    width: 30rem;
    height: 30rem;
    background: radial-gradient(circle,
      color-mix(in srgb, var(--color-accent, #2563eb) 35%, transparent), transparent 70%);
    animation: hero-float-2 18s ease-in-out infinite;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right,
        color-mix(in srgb, #ffffff 8%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom,
        color-mix(in srgb, #ffffff 8%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(120% 80% at 50% 0%, #000 30%, transparent 75%);
    mask-image: radial-gradient(120% 80% at 50% 0%, #000 30%, transparent 75%);
  }

  .hero__container {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    animation: hero-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem 0.4rem 0.85rem;
    background: color-mix(in srgb, var(--color-accent, #2563eb) 14%, transparent);
    color: color-mix(in srgb, var(--color-accent, #2563eb) 55%, #ffffff);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent, #2563eb) 25%, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    margin-bottom: 1.75rem;
  }

  .hero__badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent, #2563eb);
    animation: hero-pulse 2s ease-out infinite;
  }

  .hero__headline {
    font-family: var(--font-heading, inherit);
    font-size: clamp(2.5rem, 6.5vw, 4.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: #f8fafc;
    margin-bottom: 1.35rem;
  }

  .hero__headline--accent {
    background: linear-gradient(120deg,
      color-mix(in srgb, var(--color-accent, #2563eb) 65%, #ffffff),
      var(--color-accent, #2563eb));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__sub {
    font-size: 1.1875rem;
    color: color-mix(in srgb, #ffffff 72%, transparent);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .hero__cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 2.1rem;
    background: linear-gradient(135deg,
      var(--color-cta, #2563eb),
      color-mix(in srgb, var(--color-cta, #2563eb) 70%, #000));
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 0.625rem;
    text-decoration: none;
    box-shadow: 0 8px 24px -6px color-mix(in srgb, var(--color-cta, #2563eb) 60%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }

  .hero__cta-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow: 0 12px 30px -6px color-mix(in srgb, var(--color-cta, #2563eb) 70%, transparent);
    opacity: 1;
  }

  .hero__cta-arrow {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.2s ease;
  }

  .hero__cta-primary:hover .hero__cta-arrow {
    transform: translateX(3px);
  }

  .hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.95rem 2.1rem;
    background: color-mix(in srgb, #ffffff 6%, transparent);
    border: 1.5px solid color-mix(in srgb, #ffffff 22%, transparent);
    color: #e5e9f0;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 0.625rem;
    text-decoration: none;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .hero__cta-secondary:hover {
    border-color: var(--color-accent, #2563eb);
    color: var(--color-accent, #2563eb);
    background: color-mix(in srgb, var(--color-accent, #2563eb) 8%, transparent);
    opacity: 1;
  }

  /* ===== Hero motion ===== */
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent, #2563eb) 55%, transparent); }
    70%  { box-shadow: 0 0 0 0.5rem transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  @keyframes hero-float-1 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(2rem, 1.5rem); }
  }

  @keyframes hero-float-2 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(-1.5rem, 1rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__container,
    .hero__badge-dot,
    .hero__glow {
      animation: none;
    }
  }

  /* ===== Features grid ===== */
  .features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .features__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
