---
/**
 * /thank-you/
 * -----------
 * Where CloudCannon sends the visitor after a successful form post.
 *
 * The forms do a plain POST to the page they sit on; CloudCannon's hosting
 * intercepts it, stores the submission against the Inbox, forwards it to the
 * inbox targets, and answers 303 pointing here — so this page is the `action`
 * of every form on the site (src/content/forms/quote.json).
 *
 * It is noindex: a bare success page has no search value and would otherwise
 * compete with the pages that do.
 */
import '../styles/global.css';
import TreeLayout from '@astro-fleet/shared-ui/src/layouts/TreeLayout.astro';
import TreePageHero from '@astro-fleet/shared-ui/src/components/TreePageHero.astro';
import TreeCtaBanner from '@astro-fleet/shared-ui/src/components/TreeCtaBanner.astro';

import site from '../content/settings/site.json';
import chrome from '../content/settings/header-footer.json';
import home from '../content/homepage/home.json';
import page from '../content/pages/thank-you.json';
import { resolveSeo } from '../lib/seo';
import { getHeader } from '../lib/header';

const { body } = page;

const seo = resolveSeo({
  title: page.seo.title,
  description: page.seo.description,
  path: '/thank-you/',
});

// The Areas We Serve submenu is generated from the Service Areas content.
const header = await getHeader();
---

<TreeLayout
  title={seo.title}
  description={seo.description}
  keywords={page.seo.keywords}
  noindex
  siteName={site.siteName}
  logoSrc={site.logo}
  faviconSrc={site.favicon}
  header={header}
  footer={chrome.footer}
  colors={site.theme.colors}
  fonts={site.theme.fonts}
>
  <TreePageHero {...page.hero} editablePrefix="hero" compact />

  <section class="thanks">
    <div class="tree-container thanks__inner">
      <span class="thanks__check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </span>

      <h2 class="thanks__heading">{body.heading}</h2>
      <p class="thanks__desc">{body.description}</p>

      <div class="thanks__actions">
        {body.primaryCta.label && (
          <a href={body.primaryCta.href} class="thanks__btn thanks__btn--solid">
            {body.primaryCta.label}
          </a>
        )}
        {body.secondaryCta.label && (
          <a href={body.secondaryCta.href} class="thanks__btn thanks__btn--outline">
            {body.secondaryCta.label}
          </a>
        )}
      </div>

      {body.links.length > 0 && (
        <div class="thanks__links">
          {body.linksHeading && <p class="thanks__links-heading">{body.linksHeading}</p>}
          <ul class="thanks__links-list">
            {body.links.map((link) => (
              <li>
                <a href={link.href} class="thanks__link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <TreeCtaBanner {...home.ctaBanner} />
</TreeLayout>

<style>
  .thanks {
    background: var(--color-bg-surface, #fff);
    padding-block: 96px;
  }

  .thanks__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
  }

  .thanks__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-bg-accent, #c8f08f);
    color: var(--color-text-primary, #013b2d);
  }

  .thanks__check svg {
    width: 36px;
    height: 36px;
  }

  .thanks__heading {
    margin-top: 24px;
    font-size: 42px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text-primary, #013b2d);
  }

  .thanks__desc {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.8;
    color: var(--color-text-secondary, #373434);
  }

  .thanks__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }

  .thanks__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 60px;
    padding-inline: 32px;
    border-radius: var(--tree-radius-btn, 6px);
    font-size: 18px;
    line-height: 1.8;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .thanks__btn--solid {
    font-weight: 700;
    text-transform: capitalize;
    background: var(--color-bg-action, #2f8328);
    color: var(--color-text-inverse, #fff);
  }
  .thanks__btn--solid:hover {
    background: var(--color-bg-action-hover, #368a2a);
  }

  .thanks__btn--outline {
    font-weight: 600;
    text-transform: uppercase;
    border: 1px solid var(--color-border-strong, #013b2d);
    color: var(--color-text-primary, #013b2d);
  }
  .thanks__btn--outline:hover {
    background: var(--color-text-primary, #013b2d);
    color: var(--color-text-inverse, #fff);
  }

  .thanks__links {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border-subtle, #d9d9d9);
    width: 100%;
  }

  .thanks__links-heading {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-primary, #013b2d);
  }

  .thanks__links-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 32px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }

  .thanks__link {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-text-secondary, #373434);
    border-bottom: 1px solid transparent;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .thanks__link:hover {
    color: var(--color-bg-action, #2f8328);
    border-bottom-color: var(--color-bg-action, #2f8328);
  }

  /* ===== Tablet (<=1024px) ===== */
  @media (max-width: 1024px) {
    .thanks {
      padding-block: 72px;
    }
    .thanks__heading {
      font-size: 34px;
    }
    .thanks__desc {
      font-size: 16px;
      line-height: 1.7;
    }
    .thanks__btn {
      height: 54px;
      font-size: 16px;
      padding-inline: 28px;
    }
  }

  /* ===== Mobile (<=767px) ===== */
  @media (max-width: 767px) {
    .thanks {
      padding-block: 56px;
    }
    .thanks__check {
      width: 60px;
      height: 60px;
    }
    .thanks__check svg {
      width: 30px;
      height: 30px;
    }
    .thanks__heading {
      font-size: 30px;
    }
    .thanks__desc {
      font-size: 15px;
    }
    .thanks__actions {
      flex-direction: column;
      align-items: stretch;
      align-self: stretch;
      gap: 12px;
    }
    .thanks__btn {
      width: 100%;
      height: 52px;
    }
    .thanks__links {
      margin-top: 36px;
      padding-top: 24px;
    }
    .thanks__links-list {
      flex-direction: column;
      gap: 12px;
    }
    .thanks__link {
      font-size: 16px;
    }
  }
</style>
